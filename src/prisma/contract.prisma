// use prisma-8

model Users {
  id                 Int            @id @default(autoincrement())
  username           VarChar(32)    @unique
  email              VarChar(254)   @unique
  passwordHash       String         @map("password_hash")
  createdAt          TimestampString @default(now()) @map("created_at")
  updatedAt          TimestampString @default(now()) @map("updated_at")
  userRoles          UserRoles[]
  posts              Posts[]
  comments           Comments[]
  roleAuditsAsActor  RoleAuditLogs[] @relation("RoleAuditActor")
  roleAuditsReceived RoleAuditLogs[] @relation("RoleAuditTarget")

  @@map("users")
}

model Roles {
  id              Int               @id @default(autoincrement())
  name            VarChar(50)       @unique
  description     String
  userRoles       UserRoles[]
  rolePermissions RolePermissions[]
  auditLogs       RoleAuditLogs[]

  @@map("roles")
}

model Permissions {
  id              Int               @id @default(autoincrement())
  name            VarChar(100)      @unique
  description     String
  rolePermissions RolePermissions[]

  @@map("permissions")
}

model UserRoles {
  userId     Int       @map("user_id")
  roleId     Int       @map("role_id")
  assignedAt TimestampString @default(now()) @map("assigned_at")
  user       Users     @relation(fields: [userId], references: [id])
  role       Roles     @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermissions {
  roleId       Int         @map("role_id")
  permissionId Int         @map("permission_id")
  role         Roles       @relation(fields: [roleId], references: [id])
  permission   Permissions @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RoleAuditLogs {
  id           Int       @id @default(autoincrement())
  actorUserId  Int?      @map("actor_user_id")
  targetUserId Int?      @map("target_user_id")
  roleId       Int?
  action       VarChar(20)
  changedAt    TimestampString @default(now()) @map("changed_at")
  actor        Users?    @relation("RoleAuditActor", fields: [actorUserId], references: [id])
  target       Users?    @relation("RoleAuditTarget", fields: [targetUserId], references: [id])
  role         Roles?    @relation(fields: [roleId], references: [id])

  @@index([targetUserId, changedAt], map: "role_audit_target_changed_idx")
  @@map("role_audit_logs")
}

model Posts {
  id        Int       @id @default(autoincrement())
  authorId  Int       @map("author_id")
  title     VarChar(255)
  content   String
  likes     Int       @default(0)
  published Boolean   @default(false)
  createdAt TimestampString @default(now()) @map("created_at")
  updatedAt TimestampString @default(now()) @map("updated_at")
  comments  Comments[]
  author    Users     @relation(fields: [authorId], references: [id])

  @@index([published, createdAt], map: "posts_published_created_idx")
  @@map("posts")
}

model Comments {
  id        Int       @id @default(autoincrement())
  authorId  Int       @map("author_id")
  postId    Int       @map("post_id")
  content   String
  createdAt TimestampString @default(now()) @map("created_at")
  author    Users     @relation(fields: [authorId], references: [id])
  post      Posts     @relation(fields: [postId], references: [id])

  @@map("comments")
}

model Sessions {
  sid    VarChar(255) @id
  sess   Json
  expire TimestampString

  @@index([expire], map: "sessions_expire_idx")
  @@map("sessions")
}
